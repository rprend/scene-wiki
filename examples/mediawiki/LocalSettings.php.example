<?php

$wgSitename = "Scene Wiki";
$wgScriptPath = "";
$wgArticlePath = "/wiki/$1";
$wgUsePathInfo = true;

$wgDBtype = "mysql";
$wgDBserver = "db";
$wgDBname = "mediawiki";
$wgDBuser = "mediawiki";
$wgDBpassword = "change-me";

$wgEnableUploads = true;
$wgFileExtensions = [ 'png', 'gif', 'jpg', 'jpeg', 'webp', 'svg' ];

$wgGroupPermissions['*']['edit'] = false;

$wgLogo = "$wgScriptPath/resources/assets/wiki.png";

// Sidecar semantic-search assets generated by scene-wiki.
$wgHooks['SiteNoticeAfter'][] = static function ( &$siteNotice, $skin ) {
    $siteNotice .= '<div data-scene-search-app data-scene-search-base="/scene-search"></div>';
    $siteNotice .= '<script defer src="/scene-search/static/scene-search-app.js"></script>';
    return true;
};
