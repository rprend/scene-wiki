<?php

$wgSitename = "__SITE_NAME__";
$wgServer = "__SITE_SERVER__";
$wgScriptPath = "";
$wgArticlePath = "/wiki/$1";
$wgUsePathInfo = true;

$wgDBtype = "mysql";
$wgDBserver = "db";
$wgDBname = "__DB_NAME__";
$wgDBuser = "__DB_USER__";
$wgDBpassword = "__DB_PASSWORD__";

wfLoadSkin( 'Vector' );
$wgDefaultSkin = 'vector';

$wgEnableUploads = true;
$wgFileExtensions = [ 'png', 'gif', 'jpg', 'jpeg', 'webp', 'svg' ];

$wgGroupPermissions['*']['edit'] = false;

$wgLogo = "$wgScriptPath/resources/assets/wiki.png";

// Sidecar semantic-search assets generated by scene-wiki.
$wgHooks['SiteNoticeAfter'][] = static function ( &$siteNotice, $skin ) {
    $siteNotice .= '<div data-scene-search-app data-scene-search-base="__SEARCH_BASE__"></div>';
    $siteNotice .= '<script defer src="__SEARCH_APP_SCRIPT__"></script>';
    return true;
};
