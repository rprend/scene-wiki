# Cloudflare Worker app
PLATFORM_BASE_URL=https://scenewiki.net
RUNNER_API_TOKEN=replace-with-long-random-token
MAIN_DOMAIN=scenewiki.net
PAGES_PROJECT_PREFIX=scene-wiki

# Cloudflare deploy/auth
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_API_TOKEN=replace-with-api-token

# Scene wiki generation
GOOGLE_API_KEY=
GEMINI_API_KEY=
SUBSTACK_COOKIE=

# Runner behavior
RUNNER_POLL_SECONDS=20
RUNNER_WORKDIR=/absolute/path/to/scene-wiki
SCENE_WIKI_MAX_ESTIMATED_INPUT_TOKENS=
SCENE_WIKI_COST_SAMPLE_POSTS=12
SCENE_WIKI_ARCHIVE_PAGE_DELAY_SECONDS=1.5
SCENE_WIKI_POST_FETCH_DELAY_SECONDS=1.0
SCENE_WIKI_RATE_LIMIT_BASE_SECONDS=15
SCENE_WIKI_CHECKPOINT_DIR=data/archive-checkpoints
